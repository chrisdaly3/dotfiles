# This is Git's per-user configuration file.
[user]
	name = {{ .name }}
	email = {{ .email }}
[init]
	defaultBranch = main
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
	line-numbers = true
[merge]
    conflictstyle = zdiff3
